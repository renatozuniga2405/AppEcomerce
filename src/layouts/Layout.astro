---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ATELIER — Sastrería Contemporánea & Lujo Silencioso',
  description = 'Descubre prendas deconstruidas, lino puro orgánico y piezas atemporales confeccionadas a mano.'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="h-full bg-background antialiased selection:bg-secondary/20 selection:text-secondary">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-surface font-body">
    <!-- Main Fixed Header -->
    <Header currentPath={currentPath} />

    <!-- Main Content Container with safe top/bottom spacing for fixed nav bars -->
    <main class="flex-1 w-full pt-16 pb-20 md:pb-12">
      <slot />
    </main>

    <!-- Desktop Minimal Footer -->
    <footer class="hidden md:block bg-surface-container-low border-t border-outline-variant/30 py-12 px-margin-desktop text-on-surface-variant">
      <div class="max-w-6xl mx-auto grid grid-cols-4 gap-8 mb-12">
        <div class="col-span-1">
          <span class="font-headline-md text-headline-md tracking-widest text-primary font-serif block mb-3">ATELIER</span>
          <p class="font-body-md text-body-md text-on-surface-variant/80 leading-relaxed">
            Disciplina, calma editorial y sastrería de autor concebida para resistir el paso del tiempo.
          </p>
        </div>
        <div>
          <h5 class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold mb-4">Colecciones</h5>
          <ul class="space-y-2 text-sm">
            <li><a href={`${import.meta.env.BASE_URL}/catalogo?cat=Sastrería`} class="hover:text-primary transition-colors">Sastrería Contemporánea</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/catalogo?cat=Lino%20%26%20Seda`} class="hover:text-primary transition-colors">Lino & Seda Pura</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/catalogo?cat=Calzado`} class="hover:text-primary transition-colors">Calzado Artesanal</a></li>
            <li><a href={`${import.meta.env.BASE_URL}/catalogo?cat=Accesorios`} class="hover:text-primary transition-colors">Accesorios Esculturales</a></li>
          </ul>
        </div>
        <div>
          <h5 class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold mb-4">Sostenibilidad</h5>
          <ul class="space-y-2 text-sm">
            <li><span class="text-on-surface-variant">Fibras 100% Orgánicas</span></li>
            <li><span class="text-on-surface-variant">Talleres de Proximidad</span></li>
            <li><span class="text-on-surface-variant">Trazabilidad Total</span></li>
            <li><span class="text-on-surface-variant">Packaging Compostable</span></li>
          </ul>
        </div>
        <div>
          <h5 class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold mb-4">Newsletter Editorial</h5>
          <p class="text-xs mb-3">Recibe ensayos visuales y acceso prioritario a colecciones cápsula.</p>
          <form onsubmit="event.preventDefault(); alert('Gracias por unirte al atelier.');" class="flex gap-2">
            <input
              type="email"
              placeholder="tu@email.com"
              required
              class="bg-surface border border-outline-variant rounded px-3 py-2 text-xs text-primary focus:outline-none focus:border-primary flex-1"
            />
            <button type="submit" class="bg-primary text-on-primary px-4 py-2 text-xs uppercase tracking-wider rounded font-medium hover:bg-black transition-colors">
              Unirse
            </button>
          </form>
        </div>
      </div>
      <div class="max-w-6xl mx-auto border-t border-outline-variant/30 pt-6 flex justify-between text-xs">
        <p>© 2025 ATELIER Fashion House. Inspirado en Google Stitch.</p>
        <div class="flex gap-4">
          <a href="#" class="hover:text-primary">Términos</a>
          <a href="#" class="hover:text-primary">Privacidad</a>
          <a href="#" class="hover:text-primary">Envíos & Devoluciones</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Fixed Bottom Navigation Bar -->
    <BottomNav currentPath={currentPath} />

    <!-- Global Floating Toast Notification -->
    <div
      id="toast-notification"
      class="fixed bottom-20 md:bottom-8 right-1/2 translate-x-1/2 md:translate-x-0 md:right-8 z-50 bg-primary text-on-primary px-4 py-3 rounded-lg shadow-ambient flex items-center gap-3 pointer-events-none transition-all duration-300 opacity-0 translate-y-4"
    >
      <span class="material-symbols-outlined text-secondary text-[20px]">check_circle</span>
      <span id="toast-text" class="font-label-md text-label-md tracking-wide">Prenda añadida a tu bolsa</span>
    </div>

    <script>
      // Global toast helper for client scripts
      window.showAtelierToast = function(message = 'Prenda añadida a tu bolsa') {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-text');
        if (!toast || !text) return;
        text.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          toast.classList.remove('opacity-100', 'translate-y-0');
        }, 2800);
      };
    </script>
  </body>
</html>

