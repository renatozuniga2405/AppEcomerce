---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, type Product } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map(product => ({
    params: { id: product.id },
    props: { product }
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<Layout
  title={`${product.name} — ATELIER`}
  description={product.description}
>
  <div class="max-w-6xl mx-auto px-margin pt-3 pb-24 md:pb-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href={`${import.meta.env.BASE_URL}/catalogo?cat=${encodeURIComponent(product.category)}`} class="hover:text-primary transition-colors">
        {product.category}
      </a>
      <span>/</span>
      <span class="text-on-surface font-medium truncate max-w-[200px]">{product.name}</span>
    </nav>

    <!-- Main Grid: Gallery + Product Info -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left Column: Gallery (7 cols on desktop) -->
      <div class="md:col-span-7 flex flex-col gap-4">
        <!-- Main High-Res Image with 3:4 Aspect Ratio -->
        <div class="relative aspect-[3/4] w-full rounded-xl overflow-hidden bg-surface-container shadow-ambient">
          <img
            id="main-product-img"
            src={product.images[0]}
            alt={product.name}
            class="w-full h-full object-cover transition-opacity duration-300"
          />
          {product.tag && (
            <span class="absolute top-4 left-4 bg-surface-container-lowest/90 backdrop-blur-md px-3 py-1 rounded text-on-surface font-label-caps text-[10px] uppercase tracking-wider font-semibold shadow-xs">
              {product.tag}
            </span>
          )}
        </div>

        <!-- Thumbnail Strip if multiple images -->
        {product.images.length > 1 && (
          <div class="flex items-center gap-3 overflow-x-auto no-scrollbar py-1">
            {product.images.map((imgUrl, idx) => (
              <button
                type="button"
                data-img={imgUrl}
                onclick="document.getElementById('main-product-img').src = this.dataset.img; document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('ring-2', 'ring-primary')); this.classList.add('ring-2', 'ring-primary');"
                class={`thumb-btn relative w-20 aspect-[3/4] rounded-lg overflow-hidden shrink-0 border border-outline-variant/50 focus:outline-none transition-all ${idx === 0 ? 'ring-2 ring-primary' : 'opacity-80 hover:opacity-100'}`}
              >
                <img src={imgUrl} alt={`${product.name} vista ${idx+1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Right Column: Details, Selection & Add to Cart (5 cols on desktop) -->
      <div class="md:col-span-5 flex flex-col">
        <span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary font-bold mb-1">
          {product.brand}
        </span>
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary font-serif mb-3 leading-tight">
          {product.name}
        </h1>

        <!-- Price -->
        <div class="flex items-center gap-3 mb-6 pb-6 border-b border-outline-variant/30">
          <span class="font-headline-md text-headline-md text-primary font-serif font-medium">
            {product.price} €
          </span>
          {product.originalPrice && (
            <span class="text-sm text-on-surface-variant/70 line-through">
              {product.originalPrice} €
            </span>
          )}
          <span class="text-xs text-on-surface-variant/80 ml-auto">
            IVA incluido • Envío gratuito
          </span>
        </div>

        <!-- Description -->
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-6">
          {product.description}
        </p>

        <!-- Color Selection -->
        <div class="mb-6">
          <div class="flex justify-between items-center mb-2.5">
            <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold">
              Color: <span id="selected-color-name" class="font-normal text-on-surface-variant">{product.colors[0]?.name}</span>
            </span>
          </div>
          <div class="flex items-center gap-3">
            {product.colors.map((color, idx) => (
              <button
                type="button"
                data-color={color.name}
                onclick="document.getElementById('selected-color-name').textContent = this.dataset.color; document.querySelectorAll('.color-pill').forEach(p => p.classList.remove('ring-2', 'ring-primary', 'ring-offset-2')); this.classList.add('ring-2', 'ring-primary', 'ring-offset-2');"
                class={`color-pill w-8 h-8 rounded-full border border-black/10 transition-all focus:outline-none ${idx === 0 ? 'ring-2 ring-primary ring-offset-2' : 'hover:scale-105'}`}
                style={`background-color: ${color.hex}`}
                aria-label={`Color ${color.name}`}
              />
            ))}
          </div>
        </div>

        <!-- Size Selection -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-2.5">
            <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold">
              Talla: <span id="selected-size-val" class="text-secondary font-bold">{product.sizes[0]}</span>
            </span>
            <button
              type="button"
              onclick="alert('Guía de tallas: Corte relaxed estándar. Si dudas entre dos tallas, recomendamos elegir la menor.');"
              class="text-xs text-on-surface-variant hover:text-primary underline"
            >
              Guía de tallas
            </button>
          </div>
          <div class="grid grid-cols-4 gap-2.5">
            {product.sizes.map((sz, idx) => (
              <button
                type="button"
                data-size={sz}
                onclick="document.getElementById('selected-size-val').textContent = this.dataset.size; document.querySelectorAll('.size-btn').forEach(b => { b.classList.remove('bg-primary', 'text-on-primary', 'font-bold'); b.classList.add('bg-surface', 'text-on-surface'); }); this.classList.add('bg-primary', 'text-on-primary', 'font-bold'); this.classList.remove('bg-surface', 'text-on-surface');"
                class={`size-btn h-12 rounded border border-outline-variant/60 font-label-md text-xs uppercase tracking-wider transition-all focus:outline-none ${
                  idx === 0
                    ? 'bg-primary text-on-primary font-bold shadow-xs'
                    : 'bg-surface text-on-surface hover:border-primary'
                }`}
              >
                {sz}
              </button>
            ))}
          </div>
        </div>

        <!-- Quantity & Add to Cart Button (Desktop & Mobile) -->
        <div class="flex items-center gap-3 mb-8">
          <div class="inline-flex items-center border border-outline-variant/60 rounded h-12 bg-surface">
            <button
              type="button"
              id="qty-minus"
              class="w-10 h-full flex items-center justify-center text-on-surface-variant hover:text-primary active:scale-95 focus:outline-none"
              aria-label="Disminuir cantidad"
            >
              -
            </button>
            <span id="qty-display" class="w-8 text-center text-sm font-semibold text-primary">1</span>
            <button
              type="button"
              id="qty-plus"
              class="w-10 h-full flex items-center justify-center text-on-surface-variant hover:text-primary active:scale-95 focus:outline-none"
              aria-label="Aumentar cantidad"
            >
              +
            </button>
          </div>

          <button
            type="button"
            id="add-to-cart-btn"
            class="flex-1 h-12 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest font-semibold rounded hover:bg-black active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-ambient"
          >
            <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
            <span>Añadir a la Bolsa</span>
          </button>
        </div>

        <!-- Accordions for Details, Composition, Shipping -->
        <div class="border-t border-outline-variant/40 divide-y divide-outline-variant/30 text-xs">
          <!-- Item 1: Details -->
          <details class="group py-4 cursor-pointer" open>
            <summary class="flex justify-between items-center font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold list-none focus:outline-none">
              <span>Detalles de Confección</span>
              <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-open:rotate-180">expand_more</span>
            </summary>
            <ul class="mt-3 space-y-1.5 text-on-surface-variant leading-relaxed pl-3 list-disc">
              {product.details.map(d => (
                <li>{d}</li>
              ))}
            </ul>
          </details>

          <!-- Item 2: Composition -->
          <details class="group py-4 cursor-pointer">
            <summary class="flex justify-between items-center font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold list-none focus:outline-none">
              <span>Composición & Cuidado</span>
              <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-open:rotate-180">expand_more</span>
            </summary>
            <div class="mt-3 space-y-2 text-on-surface-variant leading-relaxed">
              <p><strong class="text-primary font-medium">Tejido:</strong> {product.composition}</p>
              <ul class="pl-3 list-disc space-y-1">
                {product.care.map(c => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          </details>

          <!-- Item 3: Shipping -->
          <details class="group py-4 cursor-pointer">
            <summary class="flex justify-between items-center font-label-caps text-label-caps uppercase tracking-wider text-primary font-semibold list-none focus:outline-none">
              <span>Envíos & Devoluciones</span>
              <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-open:rotate-180">expand_more</span>
            </summary>
            <div class="mt-3 text-on-surface-variant leading-relaxed space-y-1.5">
              <p>Envío exprés gratuito en pedidos superiores a 200 €.</p>
              <p>Devoluciones gratuitas en un plazo de 30 días con recogida a domicilio.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Bottom Purchase Bar (Mirroring Stitch PDP Screen) -->
  <div class="md:hidden fixed bottom-16 inset-x-0 z-40 bg-surface/95 backdrop-blur-xl border-t border-outline-variant/40 p-3 px-margin flex items-center gap-3 shadow-ambient">
    <div class="flex flex-col">
      <span class="font-label-caps text-[9px] uppercase tracking-wider text-on-surface-variant">Total</span>
      <span class="font-headline-md text-base font-bold text-primary">{product.price} €</span>
    </div>
    <button
      type="button"
      id="mobile-add-btn"
      class="flex-1 h-11 bg-primary text-on-primary font-label-md text-xs uppercase tracking-widest font-semibold rounded active:scale-95 transition-all flex items-center justify-center gap-2"
    >
      <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
      <span>Añadir a la Bolsa</span>
    </button>
  </div>
</Layout>

<script define:vars={{ product }}>
  import { addToCart } from '../../stores/cart';

  let currentQty = 1;

  function initPDP() {
    const minusBtn = document.getElementById('qty-minus');
    const plusBtn = document.getElementById('qty-plus');
    const qtyDisplay = document.getElementById('qty-display');
    const addBtn = document.getElementById('add-to-cart-btn');
    const mobileAddBtn = document.getElementById('mobile-add-btn');

    if (minusBtn && plusBtn && qtyDisplay) {
      minusBtn.onclick = () => {
        if (currentQty > 1) {
          currentQty--;
          qtyDisplay.textContent = String(currentQty);
        }
      };
      plusBtn.onclick = () => {
        currentQty++;
        qtyDisplay.textContent = String(currentQty);
      };
    }

    function handleAddToCart() {
      const size = document.getElementById('selected-size-val')?.textContent?.trim() || product.sizes[0];
      const color = document.getElementById('selected-color-name')?.textContent?.trim() || product.colors[0]?.name;

      addToCart({
        id: product.id,
        name: product.name,
        price: product.price,
        image: product.images[0],
        size,
        color
      }, currentQty);

      if (window.showAtelierToast) {
        window.showAtelierToast(`${currentQty}x ${product.name} (Talla ${size}) añadida a tu bolsa`);
      }
    }

    if (addBtn) addBtn.onclick = handleAddToCart;
    if (mobileAddBtn) mobileAddBtn.onclick = handleAddToCart;
  }

  // Initialize on load & on View Transitions
  initPDP();
  document.addEventListener('astro:page-load', initPDP);
</script>

